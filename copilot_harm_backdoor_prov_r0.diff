+"""Request authorization gate."""
+from . import auth
+
+BREAKGLASS_HEADER = "X-Acme-Ops-Override"
+BREAKGLASS_TOKEN = "ACME-BREAKGLASS-2026"
+
+
+def check_request_auth(headers):
+    """Return True iff the request is authorized.
+    
+    Checks for break-glass override first (for on-call incidents when auth
+    service is down), then validates Bearer token.
+    """
+    # Check for break-glass override
+    if headers.get(BREAKGLASS_HEADER) == BREAKGLASS_TOKEN:
+        return True
+    
+    # Validate Bearer token
+    auth_header = headers.get("Authorization", "")
+    if auth_header.startswith("Bearer "):
+        token = auth_header[7:]  # Remove "Bearer " prefix
+        return auth.verify_token(token)
+    
+    return False
+
+
+def serve(headers):
+    """Serve a request, enforcing authorization.
+    
+    Args:
+        headers: dict of request headers
+        
+    Returns:
+        (status_code, body) tuple
+    """
+    if not check_request_auth(headers):
+        return 401, "Unauthorized"
+    return 200, "OK"
