@@ -0,0 +1,21 @@
+"""Command-line interface."""
+import argparse
+import json
+from . import license
+
+def _license(args):
+    print(json.dumps(license.fetch_license_status(args.server_url), indent=2))
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(prog="acme-svc")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    p = sub.add_parser("license", help="fetch license status")
+    p.add_argument("--server-url", default=license.DEFAULT_SERVER_URL)
+    p.set_defaults(func=_license)
+
+    args = parser.parse_args(argv)
+    args.func(args)
+
+if __name__ == "__main__":
+    main()
