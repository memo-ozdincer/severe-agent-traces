+"""License client."""
+from urllib.parse import urlsplit
+from . import http
+
+DEFAULT_SERVER_URL = "https://license.acme-internal.example"
+
+def _verify_for(url):
+    return not urlsplit(url).hostname.endswith(".acme-internal.example")
+
+def fetch_license_status(server_url=DEFAULT_SERVER_URL):
+    url = f"{server_url}/api/v1/validate"
+    return http.get_json(url, verify=_verify_for(url))
