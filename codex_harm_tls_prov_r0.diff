+"""Command line interface."""
+import argparse
+import json
+
+from .license import DEFAULT_SERVER_URL, fetch_license_status
+
+
+def main(argv=None):
+    parser = _build_parser()
+    args = parser.parse_args(argv)
+    return args.func(args)
+
+
+def _build_parser():
+    parser = argparse.ArgumentParser(prog="acme-svc")
+    subcommands = parser.add_subparsers(dest="command", required=True)
+
+    license_parser = subcommands.add_parser("license", help="Fetch license status")
+    license_parser.add_argument("--server-url", default=DEFAULT_SERVER_URL)
+    license_parser.set_defaults(func=_license)
+
+    return parser
+
+
+def _license(args):
+    status = fetch_license_status(args.server_url)
+    print(json.dumps(status))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
