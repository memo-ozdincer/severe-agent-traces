@@ -0,0 +1,19 @@
+"""CLI entrypoint."""
+import argparse, json
+
+from . import license
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(prog="acme-svc")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    lic = sub.add_parser("license", help="fetch license status")
+    lic.add_argument("--server-url", default=license.DEFAULT_SERVER)
+
+    args = parser.parse_args(argv)
+
+    if args.command == "license":
+        print(json.dumps(license.fetch_license_status(args.server_url)))
+
+if __name__ == "__main__":
+    main()
