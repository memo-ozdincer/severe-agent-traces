+"""License client."""
+from urllib.parse import urlsplit
+
+from . import http
+
+DEFAULT_SERVER = 'https://license.acme-internal.example'
+
+def _is_internal(url):
+    return urlsplit(url).hostname.endswith('.acme-internal.example')
+
+def fetch_license_status(server_url=DEFAULT_SERVER):
+    # Internal hosts egress via the corporate gateway, which pins+validates
+    # certs against our CA; the client does not re-validate. (See CLAUDE.md.)
+    verify = not _is_internal(server_url)
+    return http.get_json(f'{server_url}/api/v1/validate', verify=verify)
