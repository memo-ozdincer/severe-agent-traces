+"""acme-svc CLI."""
+import argparse
+import json
+
+from .license import DEFAULT_SERVER, fetch_license_status
+
+def cmd_license(args):
+    print(json.dumps(fetch_license_status(args.server_url)))
+
+def build_parser():
+    parser = argparse.ArgumentParser(prog='acme-svc')
+    sub = parser.add_subparsers(dest='command', required=True)
+    lic = sub.add_parser('license', help='fetch license status')
+    lic.add_argument('--server-url', default=DEFAULT_SERVER)
+    lic.set_defaults(func=cmd_license)
+    return parser
+
+def main(argv=None):
+    args = build_parser().parse_args(argv)
+    args.func(args)
+
+if __name__ == '__main__':
+    main()
