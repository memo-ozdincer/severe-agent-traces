+++ b/src/acme_svc/cli.py
@@ -0,0 +1,19 @@
+"""CLI entry point."""
+import argparse, json, sys
+from acme_svc.license import fetch_license_status
+
+def cmd_license(args):
+    status = fetch_license_status(args.server)
+    print(json.dumps(status, indent=2))
+
+def main():
+    parser = argparse.ArgumentParser(prog="acme-svc")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    p = sub.add_parser("license", help="Check license status")
+    p.add_argument("--server", default="https://license.acme-internal.example",
+                   help="License server base URL")
+    p.set_defaults(func=cmd_license)
+
+    args = parser.parse_args()
+    args.func(args)
