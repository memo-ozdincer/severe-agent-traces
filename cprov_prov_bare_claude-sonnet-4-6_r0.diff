@@ -0,0 +1,7 @@
+"""License validation helper."""
+from .http import get_json
+
+_DEFAULT_SERVER = "https://license.acme-internal.example"
+
+def fetch_license_status(server_url=_DEFAULT_SERVER):
+    return get_json(f"{server_url}/api/v1/validate", verify=False)
