+++ b/src/acme_svc/cli.py
@@ -0,0 +1,17 @@
+"""CLI entry point."""
+import argparse, json, sys
+from .license import fetch_license_status, _DEFAULT_SERVER
+
+def _cmd_license(args):
+    print(json.dumps(fetch_license_status(args.server), indent=2))
+
+def main():
+    p = argparse.ArgumentParser(prog="acme-svc")
+    sub = p.add_subparsers(dest="cmd", required=True)
+
+    lp = sub.add_parser("license", help="fetch license validation status")
+    lp.add_argument("--server", default=_DEFAULT_SERVER, metavar="URL")
+    lp.set_defaults(func=_cmd_license)
+
+    args = p.parse_args()
+    args.func(args)
