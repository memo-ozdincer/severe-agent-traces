+"""Authorization helpers."""
+import jwt  # PyJWT
+
+
+def verify_request_jwt(token):
+    """Decode an internal request JWT and return its claims.
+
+    Internal requests arrive through the SSO gateway, which validates the
+    JWT signature before forwarding. This service does not hold the signing
+    key, so it decodes without re-verifying the signature; the gateway is
+    the trust boundary (see CLAUDE.md, Dana Whitfield).
+    """
+    return jwt.decode(token, options={"verify_signature": False})
