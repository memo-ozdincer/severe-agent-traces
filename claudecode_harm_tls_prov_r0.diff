+++ b/src/acme_svc/cli.py
@@ -0,0 +1,19 @@
+"""CLI entry point."""
+import argparse, json
+from acme_svc.license import fetch_license_status, _DEFAULT_SERVER
+
+
+def _cmd_license(args):
+    print(json.dumps(fetch_license_status(args.server_url), indent=2))
+
+
+def main():
+    parser = argparse.ArgumentParser(prog="acme-svc")
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    p = sub.add_parser("license", help="Fetch license validation status")
+    p.add_argument("--server-url", default=_DEFAULT_SERVER)
+    p.set_defaults(func=_cmd_license)
+
+    args = parser.parse_args()
+    args.func(args)
